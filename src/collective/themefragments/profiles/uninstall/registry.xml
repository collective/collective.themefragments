<?xml version="1.0" encoding="utf-8"?>
<registry>
  <!-- Legacy tile registration -->
  <record name="plone.app.tiles">
    <value>
      <element remove="true">collective.themefragment.fragment</element>
    </value>
  </record>

  <!-- Mosaic tile registration -->
  <records interface="plone.app.mosaic.interfaces.ITile"
           prefix="plone.app.mosaic.app_tiles.collective_themefragments_fragment"
           remove="true"
  />

  <record name="plone.app.mosaic.app_tiles.collective.themefragments_fragment.available_actions"
          remove="true"
  />

</registry>
